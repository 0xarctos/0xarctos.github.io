---
/** Tags as links to the search page, pre-filtered on that tag. */
interface Props {
	tags: string[];
}
const { tags } = Astro.props;
---

<span class="tag-list not-content">
	{tags.map((tag) => <a class="tag" href={`/writeups/?tags=${encodeURIComponent(tag)}`}>{tag}</a>)}
</span>

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		min-height: 1.35rem;
		padding: 0 0.5rem;
		line-height: 1;
		font-size: var(--sl-text-xs);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.tag:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* Comfortable touch targets. */
	@media (pointer: coarse) {
		.tag {
			min-height: 1.5rem;
		}
	}
</style>
