---
import { DIFFICULTY_LABELS } from '../lib/writeups';

interface Props {
	value: number;
}
const { value } = Astro.props;
---

<span class="difficulty" data-level={value} title={`${DIFFICULTY_LABELS[value]} (${value}/5)`}>
	{[1, 2, 3, 4, 5].map((i) => <span class:list={['pip', { on: i <= value }]} />)}
	<span class="sr-only">{value}/5</span>
</span>

<style>
	.difficulty {
		display: inline-flex;
		gap: 0.2rem;
		align-items: center;
		vertical-align: middle;
	}
	.pip {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 2px;
		background: var(--sl-color-gray-5);
	}
	.on {
		background: var(--level-color);
	}
	[data-level='1'], [data-level='2'] { --level-color: var(--sl-color-green); }
	[data-level='3'] { --level-color: var(--sl-color-orange); }
	[data-level='4'], [data-level='5'] { --level-color: var(--sl-color-red); }
</style>
