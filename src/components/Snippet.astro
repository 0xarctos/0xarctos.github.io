---
/**
 * Displays a source file (or only one region of it) with Starlight's <Code>.
 *
 * Regions are delimited in the source with comments (VS Code can fold them):
 *   # region payload
 *   ...
 *   # endregion
 *
 * Usage in a .mdx page:
 *   import solve from './chall.py?raw';
 *   <Snippet code={solve} region="payload" title="solve.py" />
 *
 * Without `region`, the whole file is shown. Region markers are never displayed.
 * Any other prop (mark, ins, del, frame...) is passed to <Code>.
 */
import { Code } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

type Props = Omit<ComponentProps<typeof Code>, 'code' | 'lang'> & {
	code: string;
	region?: string;
	lang?: string;
};

const { code, region, lang = 'py', ...rest } = Astro.props;

// Matches "# region name", "#region name", "// region name", "// #region name"...
const START = /^\s*(?:#|\/\/)\s*#?region\b\s*(.*?)\s*$/;
const END = /^\s*(?:#|\/\/)\s*#?endregion\b/;

const lines = code.replace(/\r\n/g, '\n').split('\n');
let selected: string[];

if (region) {
	const start = lines.findIndex((line) => START.exec(line)?.[1] === region);
	if (start === -1) throw new Error(`<Snippet>: region "${region}" not found`);
	const end = lines.findIndex((line, i) => i > start && END.test(line));
	selected = lines.slice(start + 1, end === -1 ? undefined : end);
} else {
	selected = lines;
}

// Hide nested markers, remove common indentation and surrounding blank lines.
selected = selected.filter((line) => !START.test(line) && !END.test(line));
const indent = Math.min(
	...selected.filter((line) => line.trim()).map((line) => line.match(/^\s*/)![0].length),
);
const snippet = selected
	.map((line) => line.slice(Number.isFinite(indent) ? indent : 0))
	.join('\n')
	.replace(/^\s*\n|\s+$/g, '');
---

<Code code={snippet} lang={lang} {...rest} />
