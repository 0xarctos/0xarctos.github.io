---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import Crumbs from '../../components/Crumbs.astro';
import WriteupTable from '../../components/WriteupTable.astro';
import { ogImageMeta, AVATAR_OG_IMAGE } from '../../lib/writeups';

// One landing page per CTF at /writeups/<ctf-slug>/, listing its write-ups.
export async function getStaticPaths() {
	const writeups = await getCollection('writeups');
	const byCtf = new Map<string, { ctf: string; entries: typeof writeups }>();
	for (const entry of writeups) {
		const slug = entry.id.split('/')[0]; // id is "<ctf-slug>/<challenge-slug>"
		const group = byCtf.get(slug) ?? { ctf: entry.data.ctf, entries: [] };
		group.entries.push(entry);
		byCtf.set(slug, group);
	}
	return [...byCtf].map(([slug, group]) => ({
		params: { ctf: slug },
		props: {
			ctf: group.ctf,
			entries: group.entries.sort(
				(a, b) => a.data.difficulty - b.data.difficulty || a.data.title.localeCompare(b.data.title),
			),
		},
	}));
}

const { ctf, entries } = Astro.props;
---

<StarlightPage frontmatter={{ title: ctf, tableOfContents: false, head: ogImageMeta(AVATAR_OG_IMAGE) }}>
	<Crumbs items={[{ label: 'All write-ups', href: '/writeups/' }, { label: ctf }]} />

	<p>{entries.length} write-up{entries.length > 1 ? 's' : ''} for this CTF, easiest first.</p>

	<WriteupTable entries={entries} />
</StarlightPage>
