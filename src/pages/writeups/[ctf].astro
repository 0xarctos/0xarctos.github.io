---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Badge } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import Difficulty from '../../components/Difficulty.astro';
import TagList from '../../components/TagList.astro';
import { DIFFICULTY_LABELS, categoryVariant } from '../../lib/writeups';

// One landing page per CTF at /writeups/<ctf-slug>/, listing its write-ups.
export async function getStaticPaths() {
	const writeups = await getCollection('writeups');
	const byCtf = new Map<string, { ctf: string; entries: typeof writeups }>();
	for (const entry of writeups) {
		const slug = entry.id.split('/')[0]; // id is "<ctf-slug>/<challenge-slug>"
		const group = byCtf.get(slug) ?? { ctf: entry.data.ctf, entries: [] };
		group.entries.push(entry);
		byCtf.set(slug, group);
	}
	return [...byCtf].map(([slug, group]) => ({
		params: { ctf: slug },
		props: {
			ctf: group.ctf,
			entries: group.entries.sort(
				(a, b) => a.data.difficulty - b.data.difficulty || a.data.title.localeCompare(b.data.title),
			),
		},
	}));
}

const { ctf, entries } = Astro.props;
---

<StarlightPage frontmatter={{ title: ctf, tableOfContents: false }}>
	<nav class="crumbs">
		<a href="/writeups/">All write-ups</a> <span>/</span> <span>{ctf}</span>
	</nav>

	<p>{entries.length} write-up{entries.length > 1 ? 's' : ''} for this CTF.</p>

	<table class="results">
		<thead>
			<tr><th class="cat-col" /><th>Challenge</th><th>Difficulty</th><th>Tags</th></tr>
		</thead>
		<tbody>
			{
				entries.map(({ id, data }) => (
					<tr>
						<td class="cat-col"><Badge text={data.category} variant={categoryVariant(data.category)} /></td>
						<td><a href={`/writeups/${id}/`}>{data.title}</a></td>
						<td>
							<Difficulty value={data.difficulty} /> {DIFFICULTY_LABELS[data.difficulty]}
						</td>
						<td><TagList tags={data.tags} /></td>
					</tr>
				))
			}
		</tbody>
	</table>
</StarlightPage>

<style>
	.crumbs {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-bottom: 0.5rem;
	}
	.crumbs span {
		margin-inline: 0.3rem;
	}
	.results {
		width: 100%;
	}
	.results th,
	.results td {
		vertical-align: middle;
	}
	/* Narrow leftmost column holding the category badge. */
	.cat-col {
		width: 1%;
		white-space: nowrap;
		padding-inline-end: 0.5rem;
	}
</style>
