---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import WriteupTable from '../../components/WriteupTable.astro';
import { DIFFICULTY_LABELS, ogImageMeta, AVATAR_OG_IMAGE } from '../../lib/writeups';

const writeups = (await getCollection('writeups')).sort(
	(a, b) => a.data.ctf.localeCompare(b.data.ctf) || a.data.title.localeCompare(b.data.title),
);

// Every tag with its number of write-ups, most used first.
const counts = new Map<string, number>();
for (const { data } of writeups) for (const t of data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<StarlightPage frontmatter={{ title: 'Write-ups', tableOfContents: false, head: ogImageMeta(AVATAR_OG_IMAGE) }}>
	<p>CTF write-ups: each one is the solve script, commented. Filter by technique and minimum difficulty.</p>

	<form id="filters" class="filters not-content">
		<details id="filters-panel" open>
			<summary>
				<span>Filters</span>
				<span id="active" class="active" hidden></span>
				<span id="count" class="count" aria-live="polite"></span>
			</summary>

			<div class="panel">
				<fieldset>
					<legend>Tags <small>(match all selected)</small></legend>
					<div class="tags">
						{
							tags.map(([tag, n]) => (
								<label class="tag">
									<input type="checkbox" name="tags" value={tag} />
									{tag} <small>{n}</small>
								</label>
							))
						}
					</div>
				</fieldset>

				<div class="controls">
					<label class="min">
						<span>Min difficulty</span>
						<select name="min">
							{[1, 2, 3, 4, 5].map((d) => <option value={d}>{d} - {DIFFICULTY_LABELS[d]}</option>)}
						</select>
					</label>
					<button type="reset">Clear</button>
				</div>
			</div>
		</details>
	</form>

	<WriteupTable entries={writeups} showCtf tagMode="filter" />
	<p id="empty" class="empty not-content" hidden>No write-up matches these filters.</p>
</StarlightPage>

<script>
	const form = document.getElementById('filters') as HTMLFormElement;
	const panel = document.getElementById('filters-panel') as HTMLDetailsElement;
	const rows = [...document.querySelectorAll<HTMLTableRowElement>('.wt tbody tr')];
	const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="tags"]')];
	const min = form.querySelector<HTMLSelectElement>('select[name="min"]')!;
	const active = document.getElementById('active')!;

	function apply() {
		const selected = boxes.filter((b) => b.checked).map((b) => b.value);
		const minDiff = Number(min.value);
		let shown = 0;
		for (const row of rows) {
			const rowTags = row.dataset.tags!.split(' ');
			const ok = Number(row.dataset.difficulty) >= minDiff && selected.every((t) => rowTags.includes(t));
			row.hidden = !ok;
			if (ok) shown++;
		}
		document.getElementById('count')!.textContent = `${shown} / ${rows.length}`;
		document.getElementById('empty')!.hidden = shown > 0;

		// Number of active filters, shown in the summary when the panel is collapsed.
		const n = selected.length + (minDiff > 1 ? 1 : 0);
		active.hidden = n === 0;
		active.textContent = `${n} active`;

		// Keep filters in the URL so a filtered view can be shared or bookmarked.
		const params = new URLSearchParams();
		if (selected.length) params.set('tags', selected.join(','));
		if (minDiff > 1) params.set('min', String(minDiff));
		const query = params.toString();
		history.replaceState(null, '', query ? `?${query}` : location.pathname);
	}

	// Initial state from the URL (?tags=rop,ret2win&min=2).
	const params = new URLSearchParams(location.search);
	const fromUrl = (params.get('tags') ?? '').split(',').filter(Boolean);
	for (const b of boxes) b.checked = fromUrl.includes(b.value);
	min.value = params.get('min') ?? '1';

	form.addEventListener('change', apply);
	form.addEventListener('reset', () => setTimeout(apply));
	// Clicking a tag in the list adds it to the filter.
	document.querySelector('.wt')!.addEventListener('click', (e) => {
		const tag = (e.target as HTMLElement).closest<HTMLElement>('.tag-btn')?.dataset.tag;
		const box = boxes.find((b) => b.value === tag);
		if (box) {
			box.checked = true;
			apply();
			// On mobile the panel may be collapsed: scroll up so the change is visible.
			if (!panel.open) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}
	});
	apply();
</script>

<style>
	/* ---------- Base (mobile) ---------- */
	.filters details {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	.filters summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0 0.75rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}
	.filters summary::-webkit-details-marker {
		display: none;
	}
	.filters summary::before {
		content: '\203A';
		display: inline-block;
		width: 0.6rem;
		font-size: 1.1rem;
		line-height: 1;
		text-align: center;
		transition: transform 0.15s;
	}
	.filters details[open] summary::before {
		transform: rotate(90deg);
	}
	.filters summary:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		border-radius: 0.5rem;
	}
	.active {
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 400;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.count {
		margin-inline-start: auto;
		font-size: var(--sl-text-xs);
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}

	.panel {
		display: grid;
		gap: 0.6rem;
		padding: 0 0.75rem 0.75rem;
	}
	.panel fieldset {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.panel legend {
		margin-bottom: 0.35rem;
		padding: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.tag {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 1.6rem;
		margin: 0;
		padding: 0 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		cursor: pointer;
		font-size: var(--sl-text-xs);
		line-height: 1;
		white-space: nowrap;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
	}
	/* Hide the checkbox without letting it affect layout. */
	.tag input {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: 0;
		opacity: 0;
		pointer-events: none;
	}
	.tag small {
		font-size: 0.85em;
		color: var(--sl-color-gray-3);
	}
	.tag:has(input:checked) {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.tag:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.min {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: 1;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		white-space: nowrap;
	}
	.min select {
		flex: 1;
		min-width: 0;
	}
	/* 16px on form fields: avoids the iOS zoom on focus. */
	.controls select,
	.controls button {
		min-height: 2.25rem;
		margin: 0;
		padding: 0 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
		font-size: 16px;
	}
	.controls button {
		cursor: pointer;
	}
	.controls button:hover {
		border-color: var(--sl-color-gray-3);
	}

	.empty {
		margin-top: 0.75rem;
		padding: 1rem;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	/* ---------- Mouse: denser controls ---------- */
	@media (pointer: fine) {
		.filters summary {
			min-height: 2.1rem;
		}
		.tag {
			min-height: 1.45rem;
		}
		.min {
			flex: 0 1 auto;
		}
		.min select {
			flex: 0 1 auto;
		}
		.controls select,
		.controls button {
			min-height: 1.9rem;
			font-size: var(--sl-text-sm);
		}
	}
</style>
